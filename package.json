{
  "name": "agentic-rag-chatbot",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable agentic RAG chatbot platform: Node.js API, React and React Native clients.",
  "license": "MIT",
  "author": "Ankur Pawar",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config packages/server/vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/server/dist/store/migrate-cli.js",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
