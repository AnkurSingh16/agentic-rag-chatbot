# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.

# Chat model (Anthropic). Leave empty to run with CHAT_PROVIDER=fake or ollama.
ANTHROPIC_API_KEY=
CHAT_PROVIDER=fake
CHAT_MODEL=

# Embeddings. voyage | ollama | fake
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# Local Ollama, used when either provider above is set to ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
