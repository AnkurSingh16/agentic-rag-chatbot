# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.

# Chat model (Anthropic). Leave empty to run with CHAT_PROVIDER=fake or ollama.
ANTHROPIC_API_KEY=
CHAT_PROVIDER=fake
CHAT_MODEL=

# Embeddings. voyage | ollama | fake
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# Local Ollama, used when either provider above is set to ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# PostgreSQL. docker compose reads POSTGRES_PASSWORD from this file for the rag_admin superuser.
POSTGRES_PASSWORD=
# Administrator connection, used only by `npm run db:migrate`:
# postgres://rag_admin:<POSTGRES_PASSWORD>@127.0.0.1:5432/rag
DATABASE_ADMIN_URL=
# Passwords the migration runner gives rag_runtime and rag_ingest when it creates them.
# 16 to 256 characters each, and different from each other.
RAG_RUNTIME_PASSWORD=
RAG_INGEST_PASSWORD=
# Server connection: postgres://rag_runtime:<RAG_RUNTIME_PASSWORD>@127.0.0.1:5432/rag
DATABASE_URL=
# Training connection: postgres://rag_ingest:<RAG_INGEST_PASSWORD>@127.0.0.1:5432/rag
DATABASE_INGEST_URL=
