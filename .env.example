# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.
# The scripts and the server read this file with `node --env-file-if-exists=.env`.
# Setup guide: docs/local-setup.md

# --- Chat model (ADR 0008) ---
# Anthropic API key for live mode only. Keep it in this file, never in a shell profile.
ANTHROPIC_API_KEY=
# mock (default; no key, no network) or anthropic. npm run dev forces mock, npm run dev:live anthropic.
LLM_PROVIDER=mock
# Model when an instance sets no models.chat. Empty means claude-haiku-5-5.
LLM_MODEL=

# --- Embeddings ---
# local (all-MiniLM-L6-v2 inside Node, downloaded once) or mock (offline hash vectors). Empty means local.
EMBEDDING_PROVIDER=
# Where the local embedding model is cached. Empty means .cache/models.
MODEL_CACHE_DIR=

# --- Chat server (apps/server) ---
# Serve only this instance. Empty means every folder in INSTANCES_DIR.
INSTANCE_ID=
# Override INSTANCE_ID's auth mode; it may only tighten the configured mode (ADR 0003).
AUTH_MODE=
# Folder holding one folder per instance. Empty means ./instances.
INSTANCES_DIR=
# Address to listen on. Empty means 127.0.0.1.
HOST=
# Port to listen on. Empty means 4000.
PORT=
# HMAC secret for session tokens, at least 32 characters. Required with NODE_ENV=production;
# empty in development means a random secret per start.
SESSION_SECRET=
# Comma-separated proxy addresses or CIDR ranges whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=
# 1 skips `docker compose up` in npm run dev, for a PostgreSQL you run yourself.
DEV_SKIP_DOCKER=

# --- PostgreSQL ---
# Password of the rag_admin superuser that docker compose creates.
POSTGRES_PASSWORD=
# Administrator connection, used only for migrations:
# postgres://rag_admin:<POSTGRES_PASSWORD>@127.0.0.1:5432/rag
DATABASE_ADMIN_URL=
# Passwords the migration runner gives rag_runtime and rag_ingest when it creates them.
# 16 to 256 characters each, and different from each other.
RAG_RUNTIME_PASSWORD=
RAG_INGEST_PASSWORD=
# Server connection: postgres://rag_runtime:<RAG_RUNTIME_PASSWORD>@127.0.0.1:5432/rag
DATABASE_URL=
# Training connection: postgres://rag_ingest:<RAG_INGEST_PASSWORD>@127.0.0.1:5432/rag
DATABASE_INGEST_URL=

# --- Web demo (apps/web-demo) ---
# Chat API URL the widget calls. Empty means http://127.0.0.1:4000.
VITE_CHAT_API_URL=
