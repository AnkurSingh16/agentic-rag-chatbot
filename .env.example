# Copy to .env and fill in the values. .env is git-ignored; never commit real keys.
# The scripts and the server read this file with `node --env-file-if-exists=.env`.
# Setup guide: docs/local-setup.md

# --- Chat model (ADR 0008) ---
# Anthropic API key for live mode only. Keep it in this file, never in a shell profile.
ANTHROPIC_API_KEY=
# mock (default; no key, no network), anthropic or ollama. npm run dev forces mock, npm run dev:live
# anthropic and npm run dev:ollama ollama.
LLM_PROVIDER=mock
# Model when an instance sets no models.chat. Empty means claude-haiku-5-5.
LLM_MODEL=

# --- Ollama, the free local model for development and demos (docs/local-setup.md) ---
# Address of the local Ollama server. Empty means http://127.0.0.1:11434.
OLLAMA_BASE_URL=
# Model to run with LLM_PROVIDER=ollama; pull it first with ollama pull. Empty means qwen2.5:7b on
# machines with 16 GB of memory or more, and llama3.2:3b on machines with less.
OLLAMA_MODEL=
# true allows an OLLAMA_BASE_URL that is not a loopback address. Keep it empty so prompts stay on this machine.
OLLAMA_ALLOW_REMOTE=

# --- Embeddings ---
# local (all-MiniLM-L6-v2 inside Node, downloaded once) or mock (offline hash vectors). Empty means local.
EMBEDDING_PROVIDER=
# Where the local embedding model is cached. Empty means .cache/models.
MODEL_CACHE_DIR=

# --- Chat server (apps/server) ---
# Serve only this instance. Empty means every folder in INSTANCES_DIR.
INSTANCE_ID=
# Override INSTANCE_ID's auth mode; it may only tighten the configured mode (ADR 0003).
AUTH_MODE=
# Folder holding one folder per instance. Empty means ./instances.
INSTANCES_DIR=
# Address to listen on. Empty means 127.0.0.1.
HOST=
# Port to listen on. Empty means 4100.
PORT=
# HMAC secret for session tokens, at least 32 characters. Required with NODE_ENV=production,
# LLM_PROVIDER=anthropic (npm run dev:live) or a HOST that is not loopback; otherwise empty means
# a random secret per start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated proxy addresses or CIDR ranges whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=
# 1 skips `docker compose up` in npm run dev, for a PostgreSQL you run yourself.
DEV_SKIP_DOCKER=

# --- PostgreSQL ---
# Password of the rag_admin superuser that docker compose creates.
# Host port for the local PostgreSQL container. Empty means 5433, which leaves 5432 free
# for another project's database. Change the port in the three database URLs to match.
RAG_POSTGRES_PORT=

POSTGRES_PASSWORD=
# Administrator connection, used only for migrations:
# postgres://rag_admin:<POSTGRES_PASSWORD>@127.0.0.1:5433/rag
DATABASE_ADMIN_URL=
# Passwords the migration runner gives rag_runtime and rag_ingest when it creates them.
# 16 to 256 characters each, and different from each other.
RAG_RUNTIME_PASSWORD=
RAG_INGEST_PASSWORD=
# Server connection: postgres://rag_runtime:<RAG_RUNTIME_PASSWORD>@127.0.0.1:5433/rag
DATABASE_URL=
# Training connection: postgres://rag_ingest:<RAG_INGEST_PASSWORD>@127.0.0.1:5433/rag
DATABASE_INGEST_URL=

# --- Web demo (apps/web-demo) ---
# Port of the web demo. Empty means 5180. If you change it, add http://127.0.0.1:<port> to
# allowedOrigins in instances/demo/instance.yaml, or the API answers 403.
WEB_DEMO_PORT=
# Chat API URL the widget calls. Empty means http://127.0.0.1:4100.
VITE_CHAT_API_URL=
